{
  "name": "wdim-what-did-i-miss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, spoiler-bounded video companion browser extension.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:firefox": "node scripts/dev.mjs --firefox",
    "dev:manual": "node scripts/dev.mjs --manual",
    "fixture": "node scripts/fixture-server.mjs",
    "build": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "browser:install": "playwright install chromium --no-shell",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check && npm run build && npm run build:firefox"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
