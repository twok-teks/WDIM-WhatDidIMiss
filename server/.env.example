# Copy to server/.env. Never put this key in extension code or VITE_/WXT_ variables.
GROQ_API_KEY=
# Use the ID shown on chrome://extensions for your AI-enabled build.
WDIM_EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_YOUR_EXTENSION_ID
# Optional operator-reviewed story catalog. Observed captions work without this.
WDIM_KNOWLEDGE_FILE=
# Optional reviewed outside facts and earlier-work context, with source URLs/release order.
WDIM_RELATED_CONTEXT_FILE=
